# Application settings
APP_NAME=Document Center API
APP_VERSION=1.0.0
# development | staging | production
ENVIRONMENT=development
DEBUG=false

# API contract
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./app.db

# CORS: список разрешённых origin через запятую.
# Значение * запрещено при ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# JWT.
# В production секрет обязателен, уникален и содержит не менее 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
