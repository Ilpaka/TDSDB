# Application settings
APP_NAME=Document Center API
APP_VERSION=2.0.0
# development | staging | production
ENVIRONMENT=development
DEBUG=false
# Публикация /docs, /redoc и /openapi.json
DOCS_ENABLED=true

# API contract
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=sqlite:///./app.db

# CORS: список разрешённых origin через запятую.
# Значение * запрещено при ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# JWT.
# В production секрет обязателен, уникален и содержит не менее 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ресурсные ограничения
# Попыток входа с одного адреса за окно LOGIN_RATE_WINDOW_SECONDS
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Максимальный размер тела запроса, байт (1 МиБ)
MAX_REQUEST_BODY_BYTES=1048576
